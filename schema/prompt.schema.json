{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carnaverone/open-prompt-archive/schema/prompt.schema.json",
  "title": "Open Prompt Archive Published Prompt Record",
  "description": "Canonical published record for an approved redistributable AI prompt with source, license, provenance, and optional template metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "prompt",
    "type",
    "source",
    "license",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "title": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "negative_prompt": {
      "type": ["string", "null"]
    },
    "type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "llm",
        "agent",
        "audio",
        "music",
        "voice",
        "3d",
        "coding",
        "multimodal",
        "other"
      ]
    },
    "models": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": []
    },
    "language": {
      "type": ["string", "null"],
      "description": "BCP 47 language tag when known, for example en or fr-CA."
    },
    "template": {
      "type": ["object", "null"],
      "description": "Optional metadata needed to preserve a templated prompt without rendering external dataset/example content.",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": ["string", "null"],
          "description": "Template language/engine when known, for example jinja."
        },
        "dataset": {
          "type": ["string", "null"]
        },
        "subset": {
          "type": ["string", "null"]
        },
        "answer_choices": {
          "type": ["string", "null"],
          "description": "Unrendered answer-choice expression/configuration required by the template when present."
        },
        "choices_in_prompt": {
          "type": ["boolean", "null"]
        },
        "original_task": {
          "type": ["boolean", "null"]
        },
        "metrics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "reference": {
          "type": ["string", "null"]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name", "url"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "repository": {
          "type": ["string", "null"]
        },
        "author": {
          "type": ["string", "null"]
        },
        "upstream_id": {
          "type": ["string", "null"]
        },
        "revision": {
          "type": ["string", "null"]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "attribution_required", "scope_verified"],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1,
          "description": "Effective record license identifier. Use an SPDX identifier when available."
        },
        "url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "attribution_required": {
          "type": "boolean"
        },
        "attribution": {
          "type": ["string", "null"]
        },
        "scope_verified": {
          "const": true,
          "description": "Published records require verified license scope."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "attribution_required": {"const": true}
            }
          },
          "then": {
            "required": ["attribution"],
            "properties": {
              "attribution": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retrieved_at", "verified", "modified"],
      "properties": {
        "retrieved_at": {
          "type": "string",
          "format": "date"
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "verified": {
          "const": true,
          "description": "Published records must be evidence-backed and verified."
        },
        "modified": {
          "type": "boolean"
        },
        "transformation": {
          "type": ["string", "null"]
        }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "mirrored"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "kind": {
            "type": ["string", "null"],
            "enum": ["image", "video", "audio", "other", null]
          },
          "mirrored": {
            "type": "boolean"
          },
          "license": {
            "type": ["string", "null"]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "mirrored": {"const": true}
              }
            },
            "then": {
              "required": ["license"],
              "properties": {
                "license": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "default": []
    }
  }
}
